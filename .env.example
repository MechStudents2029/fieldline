# Fieldline local configuration.
# Copy to .env.local. Leave values empty to run the seeded demo with stubs.
# Never commit .env.local. Put the same names in Vercel project env and Cursor secrets.
# Do not paste live keys into chat.

# Required in production. Local dev falls back to a fixed development secret.
SESSION_SECRET=

# Optional. Local default is ./data/fieldline.db, created and seeded on first request.
# On Vercel leave this empty. The demo uses /tmp/fieldline/fieldline.db, seeded on each cold start.
# That file is not shared across instances and disappears when the function goes cold.
FIELDLINE_DB=

# Optional override for uploads and the outbox. Defaults to ./data locally and /tmp/fieldline on Vercel.
FIELDLINE_DATA_DIR=

# Vercel AI Gateway. Empty = local price-book matcher (no network, no spend).
# The model may choose price-book codes and quantities only. It never sets prices.
AI_GATEWAY_API_KEY=
AI_ESTIMATE_MODEL=anthropic/claude-sonnet-4.5

# Resend. Empty = messages append to data/outbox/email.jsonl.
RESEND_API_KEY=
RESEND_FROM=

# Twilio. All three required before any SMS leaves the machine.
# 10DLC brand/campaign is not registered. Do not send at scale.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe TEST mode only. Empty = local mirror of Stripe test bank/card numbers.
# sk_test_ + pk_test_ create a PaymentIntent (ACH first, card optional). whsec_ verifies
# payment_intent.succeeded and marks the invoice paid. Live keys are refused.
# No Connect account and no platform fee. Funds land on the account that owns the key.
# Without STRIPE_WEBHOOK_SECRET, x-fieldline-demo: 1 is accepted only outside production.
# A Vercel deploy rejects that header unless FIELDLINE_ALLOW_DEMO_WEBHOOK=1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
FIELDLINE_ALLOW_DEMO_WEBHOOK=

# Protects GET /api/cron/follow-ups. Required when NODE_ENV=production or on Vercel.
# Empty is allowed for local dev only.
CRON_SECRET=

# Leave empty for the SQLite demo (./data locally, /tmp/fieldline on Vercel).
# Set a postgres:// or postgresql:// URL to migrate and seed that database on boot.
# Use the Supabase direct connection or the session pooler (port 5432), not the transaction pooler.
# The app still filters org_id. Apply supabase/rls.sql yourself; this connection should be
# the database owner or service role so those policies do not block the server.
DATABASE_URL=

# Supabase Auth is optional. Leave these empty to keep the demo password (demo).
# Set the URL plus the anon key, or the newer publishable key, to sign in with Supabase.
# The proxy refreshes that session with getClaims(). The office cookie is still the Fieldline membership.
# Apply supabase/rls.sql on the hosted database. Point DATABASE_URL at the owner or service role
# so portal, pay, cron, and webhooks are not blocked by RLS. Office queries still filter org_id.
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never put it in a NEXT_PUBLIC_ variable.
# Set SESSION_SECRET before a production deploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
